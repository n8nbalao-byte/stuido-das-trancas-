# Banco MySQL/MariaDB (Hostinger em produção; Docker no desenvolvimento)
DATABASE_URL=mysql://root:dev@localhost:3306/studio
# Banco descartável usado por npm test (apagado e recriado a cada execução). Vazio = pula os testes de banco.
TEST_DATABASE_URL=mysql://root:dev@localhost:3306/studio_test

PORT=3000
NODE_ENV=development
# Endereço público do site (vai nas mensagens de WhatsApp)
PUBLIC_URL=http://localhost:5173

# Evolution API (WhatsApp). Só no servidor; nunca no front nem no repositório.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Fotos enviadas pelo painel. Em produção: fora da pasta do deploy (ex.: /home/<usuario>/studio-uploads)
UPLOAD_DIR=./uploads
